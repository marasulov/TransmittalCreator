<Window x:Class="TestWPF.StyleTriggersSample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestWPF"
        xmlns:vm ="clr-namespace:TestWPF.ViewModel"
        
        xmlns:vm2 ="clr-namespace:TransmittalCreator.ViewModels;assembly=TransmittalCreator.ViewModels"
        mc:Ignorable="d"
        Title="StyleTriggersSample" Height="450" Width="800">
    <Window.DataContext>
    <!--<vm:MainViewModel></vm:MainViewModel>-->
    <vm2:CreatePdfVm/>
    </Window.DataContext>
    <Grid>
        
        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsAttributeChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Name="attributeCheckBox"/>

        <ComboBox Grid.Row="2" Grid.Column="2" 
                  VerticalAlignment="Center" Name="comboAttributes" Height="40"
                  ItemsSource="{Binding Attributes}"
                  SelectedItem="{Binding SelectedAttr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                  
                  FontSize="12" Margin="8 0 8 0" 
                  VerticalContentAlignment="Center">

            <ComboBox.ItemTemplate>
                <!--<DataTemplate DataType="{x:Type model:BlockAttribute}">
                    <TextBlock Text="{Binding Path=Name}"></TextBlock>
                </DataTemplate>-->
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="Thin" xml:space="preserve" 
                                       Text="Attribute Name: "/>
                            <TextBlock FontWeight="Medium" Name="AttrNameTextBlock"  
                                       Text="{Binding Path=AttributeName}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="Thin" xml:space="preserve" Text="Attribute Value: "/>
                            <TextBlock FontWeight="DemiBold" Name="attrValueTextBox"  
                                       Text="{Binding Path = AttributeValue}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>


    </Grid>
</Window>
