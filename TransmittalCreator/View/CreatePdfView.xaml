<Window x:Class="TransmittalCreator.View.CreatePdfView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:no="clr-namespace:TransmittalCreator.Utils.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        xmlns:viewModels="clr-namespace:TransmittalCreator.ViewModels;assembly=TransmittalCreator.ViewModels"
        mc:Ignorable="d"
        Title="CreatePdf"
        Height="310"
        Width="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MinHeight="250"
        MinWidth="400"
        Topmost="True"
        Style="{DynamicResource WindowElementStyle}">

    <Window.DataContext>
        <viewModels:CreatePdfVm />
        
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="2" />
            </Style>


            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Grid VerticalAlignment="Stretch" Margin="8 2 8 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center">Select block attribute</TextBlock>
            <CheckBox Grid.Row="0" Grid.Column="1"
                      IsChecked="{Binding IsAttributeChecked, UpdateSourceTrigger=PropertyChanged}"
                      Name="attributeCheckBox" />
            <ComboBox Grid.Row="0" Grid.Column="2"
                      VerticalAlignment="Center" Name="comboAttributes" Height="40"
                      ItemsSource="{Binding Attributes}"
                      SelectedItem="{Binding SelectedAttr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      IsEnabled="{Binding IsChecked, ElementName=attributeCheckBox}"
                      FontSize="12" Margin="8 0 8 0"
                      VerticalContentAlignment="Center">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Select attribute" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="Thin" xml:space="preserve"
                                           Text="Attribute Name: " />
                                <TextBlock FontWeight="Medium" Name="AttrNameTextBlock"
                                           Text="{Binding Path=AttributeName}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="Thin" xml:space="preserve" Text="Attribute Value: " />
                                <TextBlock FontWeight="DemiBold" Name="attrValueTextBox"
                                           Text="{Binding Path = AttributeValue}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Numbering start with:</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="1" Name="numberingCheckbox"
                      IsChecked="{Binding IsCheckedNumbering, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="2" Grid.Row="1" Name="numberingTextbox"
                     no:NumberOnly.IsEnabled="True"
                     Text="{Binding RenumberStartValue ,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     IsEnabled="{Binding IsChecked, ElementName=numberingCheckbox}" Margin="8 0 8 0">
                <!--<TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignPaper}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Text"
                                Value="{Binding Path=RenumberStartValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=numberingCheckbox, Path=IsChecked}" Value="True">
                                <Setter Property="Text" Value="" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>-->
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter start value" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Prefix</TextBlock>
            <TextBox Grid.Column="2" Grid.Row="2" Name="prefixTextBox"
                     Text="{Binding Path=Prefix}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Margin="8 0 8 0">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter prefix" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Suffix</TextBlock>
            <!--<CheckBox Grid.Column="1" Grid.Row="3"></CheckBox>-->
            <TextBox Grid.Column="2" Grid.Row="3" Name="suffixTextBox"
                     Text="{Binding Path=Suffix}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Margin="8 0 8 0">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter suffix " />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>
            <TextBlock Grid.Column="0" Grid.Row="4" Text="Filename" />
            <TextBlock Grid.Column="2" Grid.Row="4" x:Name="fileNameTextblock"
                       Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Name="TextBlock1" Visibility="Collapsed" />

            <TextBox Grid.Column="0" Grid.Row="5" Text="Printing numbering order" Margin="2 3 5 0" />
            <StackPanel Grid.Column="2" Grid.Row="5" Orientation="Horizontal" Margin="5">
                <RadioButton Content="X" Margin="2 0 5 0" Name="RadioButtonX"
                             IsChecked="{Binding IsX}" />
                <RadioButton Content="Y" Margin="2 0 5 0" Name="RadioButtonY"
                             IsChecked="{Binding IsY}" />
                <RadioButton Content="Select order" Margin="2 0 5 0"
                             IsChecked="{Binding IsSelectedOrder}"
                             x:Name="RadioButtonSelOrder" />
            </StackPanel>
            <StackPanel Grid.Row="6" Grid.ColumnSpan="3">
                <Button Name="createButton"
                        TabIndex="3"
                        Command="{Binding PrintPagesCommand}"
                        CommandParameter="Clicked" Cursor="Hand">
                    Create PDF
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>