<Window x:Class="TransmittalCreator.View.RenumberPagesInLayoutSpaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TransmittalCreator.Utils.Controls"
        xmlns:viewModels="clr-namespace:TransmittalCreator.ViewModels;assembly=TransmittalCreator.ViewModels"
        mc:Ignorable="d"
        Title="RenumberPagesView" Height="250" Width="300" 
        Style="{DynamicResource WindowElementStyle}">

    <!--<Window.DataContext>
        <viewModels:RenumberPagesViewModel></viewModels:RenumberPagesViewModel>
    </Window.DataContext>-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Grid VerticalAlignment="Stretch" Margin="8 2 8 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
                <RowDefinition Height="*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Numbering start: <LineBreak/>Нумеровать с:</TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Name="numberingStartTextbox" 
                     Text="{Binding Path=RenumberStartValue}" controls:NumberOnly.IsEnabled="True" 
                     Margin="8 0 8 0"/>
            <!--<CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsCheckedAttribute, UpdateSourceTrigger=PropertyChanged}" Name="attributeCheckBox"/>-->

            <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Insert total pages <LineBreak/> Вставить кол-во Листов</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="1" Name="numberingCheckbox" IsChecked="{Binding InsertTotalPages, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
            <!--<TextBox Grid.Column="2" Grid.Row="1" Name="numberingTextbox" 
                     Text="{Binding Path=NumberingValue}" controls:NumberOnly.IsEnabled="True"
                     IsEnabled="{Binding IsChecked, ElementName=numberingCheckbox}" Margin="8 0 8 0"/>-->

            <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Renumber Layouts <LineBreak/>Перенумеровать Листы</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="2" Name="numberingLayCheckbox" IsChecked="{Binding RenumberLayouts, UpdateSourceTrigger=PropertyChanged}"></CheckBox>

            <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Text="Prefix / Префикс"/>
            <!--<CheckBox Grid.Column="1" Grid.Row="2" ></CheckBox>-->
            <TextBox Grid.Row="3" Name="prefixTextBox" Text="{Binding Path=Prefix}" Margin="151,0,0,25" Grid.ColumnSpan="2" Grid.RowSpan="2"/>

            <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="Suffix / Суффикс"/>
            <!--<CheckBox Grid.Column="1" Grid.Row="3"></CheckBox>-->
            <TextBox Grid.Row="4" Name="suffixTextBox" Text="{Binding Path=Suffix}" Margin="151,0,0,45" Grid.ColumnSpan="2" Grid.RowSpan="2"/>

            <TextBlock Grid.Column="0" Grid.Row="5"><Run Text="Sample / "/><Run Language="ru-ru" Text="Образец"/></TextBlock>
            <TextBlock Grid.Column="2" Grid.Row="5" x:Name="fileNameTextblock" Text="{Binding FileName}"/>

            <!-- sample-->
            <TextBlock Name="TextBlock1" Visibility="Collapsed" ></TextBlock>
            <StackPanel Grid.Row="6" Grid.ColumnSpan="2">
                <Button Name="createButton" 
                        TabIndex="3" 
                        Command="{Binding RenumberPagesCommand}" CommandParameter="Hai">Renumber/Перенумеровать</Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
