<Window x:Class="TransmittalCreator.View.RenumberPagesInLayoutSpaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TransmittalCreator.Utils.Controls"
        xmlns:viewModels="clr-namespace:TransmittalCreator.ViewModels;assembly=TransmittalCreator.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Renumber Pages"
        Height="350" Width="350"
        MinHeight="250" MinWidth="300"
        Style="{DynamicResource WindowElementStyle}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:RenumberPagesViewModel />
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="2" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Grid VerticalAlignment="Stretch" Margin="8 2 8 2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0">Numbering start: </TextBlock>
            <TextBox Grid.Column="1" Grid.Row="0" Name="numberingStartTextbox"
                     Text="{Binding Path=RenumberStartValue}"
                     controls:NumberOnly.IsEnabled="True"
                     Margin="8 0 8 0"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter start num" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>
            <!--<CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsCheckedAttribute, UpdateSourceTrigger=PropertyChanged}" Name="attributeCheckBox"/>-->

            <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Insert total pages </TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="1" Name="numberingCheckbox"
                      Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}" IsChecked="{Binding InsertTotalPages}" />

            <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Renumber Layouts </TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="2" Name="numberingLayCheckbox"
                      Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                      IsChecked="{Binding RenumberLayouts}" />

            <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Delete empty Layouts</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="3" Name="deleteLayCheckbox"
                      Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                      IsChecked="{Binding DeleteEmptyLayouts}" />

            <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="Prefix" />
            <!--<CheckBox Grid.Column="1" Grid.Row="2" ></CheckBox>-->
            <TextBox Grid.Column="1" Grid.Row="4" Name="prefixTextBox"
                     Text="{Binding Path=Prefix}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter prefix" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBlock Grid.Column="0" Grid.Row="5" VerticalAlignment="Center" Text="Suffix " />
            <TextBox Grid.Column="1" Grid.Row="5" Name="suffixTextBox"
                     Text="{Binding Path=Suffix}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.PrefixText="">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter suffix " />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <!-- sample-->
            <TextBlock Grid.Column="0" Grid.Row="6">Sample </TextBlock>
            <TextBlock Grid.Column="1" Grid.Row="6" x:Name="fileNameTextblock"
                       Text="{Binding PageName}"
                       materialDesign:TextBlockAssist.AutoToolTip="True" />

            <Button Grid.Column="0" Name="createButton" Grid.Row="7" Grid.ColumnSpan="2" VerticalAlignment="Center"
                    TabIndex="1"
                    Command="{Binding RenumberPagesCommand}"
                    CommandParameter="Clicked">
                Renumber
            </Button>

        </Grid>
    </DockPanel>
</Window>