<Window x:Class="TransmittalCreator.View.RenumberPagesInLayoutSpaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TransmittalCreator.Utils.Controls"
        mc:Ignorable="d"
        Title="" Height="320" Width="300" 
        Style="{DynamicResource WindowElementStyle}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <!--<Window.DataContext>
        <viewModels:RenumberPagesViewModel></viewModels:RenumberPagesViewModel>
    </Window.DataContext>-->
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2"/>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>

        <Grid VerticalAlignment="Stretch" Margin="8 2 8 2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0">Numbering start: <LineBreak/>Нумеровать с:</TextBlock>
            <TextBox Grid.Column="1" Grid.Row="0" Name="numberingStartTextbox" 
                     Text="{Binding Path=RenumberStartValue}" controls:NumberOnly.IsEnabled="True" 
                     Margin="8 0 8 0"/>
            <!--<CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsCheckedAttribute, UpdateSourceTrigger=PropertyChanged}" Name="attributeCheckBox"/>-->

            <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Insert total pages <LineBreak/> Вставить кол-во Листов</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="1" Name="numberingCheckbox" IsChecked="{Binding InsertTotalPages, UpdateSourceTrigger=PropertyChanged}"></CheckBox>
            <!--<TextBox Grid.Column="2" Grid.Row="1" Name="numberingTextbox" 
                     Text="{Binding Path=NumberingValue}" controls:NumberOnly.IsEnabled="True"
                     IsEnabled="{Binding IsChecked, ElementName=numberingCheckbox}" Margin="8 0 8 0"/>-->

            <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Renumber Layouts <LineBreak/>Перенумеровать Листы</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="2" Name="numberingLayCheckbox" IsChecked="{Binding RenumberLayouts, UpdateSourceTrigger=PropertyChanged}"></CheckBox>

            <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center">Delete empty Layouts<LineBreak/>Удалить пустые Листы</TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="3" Name="deleteLayCheckbox" IsChecked="{Binding RenumberLayouts, UpdateSourceTrigger=PropertyChanged}"></CheckBox>

            <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Text="Prefix / Префикс"/>
            <!--<CheckBox Grid.Column="1" Grid.Row="2" ></CheckBox>-->
            <TextBox Grid.Column="1" Grid.Row="4" Name="prefixTextBox" Text="{Binding Path=Prefix}" />

            <TextBlock Grid.Column="0" Grid.Row="5" VerticalAlignment="Center" Text="Suffix / Суффикс"/>
            <TextBox Grid.Column="1" Grid.Row="5" Name="suffixTextBox" Text="{Binding Path=Suffix}" />

            <!-- sample-->
            <TextBlock Grid.Column="0" Grid.Row="6" >Sample / Образец</TextBlock>
            <TextBlock Grid.Column="1" Grid.Row="6" x:Name="fileNameTextblock" Text="{Binding FileName}"/>

            <Button Grid.Column="0" Name="createButton"  Grid.Row="7" Grid.ColumnSpan="2" VerticalAlignment="Center"
                    TabIndex="3" 
                    Command="{Binding RenumberPagesCommand}" CommandParameter="Hai">Renumber/Перенумеровать</Button>

        </Grid>
    </DockPanel>
</Window>
