<Window x:Class="TransmittalCreator.View.RenumberPagesInModelSpaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TransmittalCreator.Utils.Controls"
        xmlns:viewModels="clr-namespace:TransmittalCreator.ViewModels.ViewModels;assembly=TransmittalCreator.ViewModels"
        mc:Ignorable="d"
        Title="" 
        Height="350" Width="350" 
        MinHeight="250" MinWidth="300"
        Style="{DynamicResource WindowElementStyle}"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        >
    <Window.DataContext>
        <viewModels:RenumberPagesInModelSpaceViewModel></viewModels:RenumberPagesInModelSpaceViewModel>
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2"/>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/WindowResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Grid VerticalAlignment="Stretch" Margin="8 2 8 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
                <RowDefinition Height="*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0">Numbering start:</TextBlock>
            <TextBox Grid.Column="1" Grid.Row="0" Name="numberingStartTextbox" 
                     Text="{Binding Path=RenumberStartValue}" 
                     controls:NumberOnly.IsEnabled="True" 
                     Margin="8 0 8 0"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter start num" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Insert total pages <!--<LineBreak/> Вставить кол-во Листов--></TextBlock>
            <CheckBox Grid.Column="1" Grid.Row="1" Name="numberingCheckbox" 
                      Style="{StaticResource MaterialDesignFilterChipPrimaryOutlineCheckBox}"
                      IsChecked="{Binding InsertTotalPages, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">Prefix </TextBlock>
            <TextBox Grid.Column="1" Grid.Row="2" Name="prefixTextBox" 
                     Text="{Binding Path=Prefix}" >
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter prefix" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBlock Grid.Column="0" Grid.Row="3" VerticalAlignment="Center"> Suffix</TextBlock>
            <TextBox Grid.Column="1" Grid.Row="3" Name="suffixTextBox" 
                     Text="{Binding Path=Suffix}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.PrefixText="">
                <materialDesign:HintAssist.Hint>
                    <StackPanel
                        Orientation="Horizontal"
                        Margin="-2 0 0 0">
                        <TextBlock
                            Text="Enter suffix" />
                    </StackPanel>
                </materialDesign:HintAssist.Hint>
            </TextBox>

            <TextBlock Grid.Column="0" Grid.Row="4" >Sample</TextBlock>
            <TextBlock Grid.Column="1" Grid.Row="4" x:Name="fileNameTextblock" Text="{Binding PageName}"/>

            <TextBlock Grid.Column="0" Grid.Row="5" 
                      Margin="2 3 5 0">
                Numbering order 
            </TextBlock>
            <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal" Margin="5" >
                <RadioButton Content="X" Margin="2 0 5 0" Name="RadioButtonX"/>
                <RadioButton Content="Y" Margin="2 0 5 0" Name="RadioButtonY"/>
                <RadioButton Content="Select order" Margin="2 0 5 0" 
                             x:Name="RadioButtonSelOrder" IsChecked="True"/>
            </StackPanel>
            
            <Button Grid.Column="0" Name="createButton"  Grid.Row="6" Grid.ColumnSpan="2" VerticalAlignment="Center"
                    TabIndex="1" 
                    Command="{Binding RenumberPagesCommand}" 
                    CommandParameter="Hai">Renumber
            </Button>
            
        </Grid>
    </DockPanel>
</Window>
